NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service role key (Supabase dashboard > Project Settings > API) -- needed by
# the WhatsApp webhook, which has no user session to authenticate DB writes with.
SUPABASE_SERVICE_ROLE_KEY=

# Meta WhatsApp Cloud API (Meta Business Manager > WhatsApp > API Setup)
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Any string you choose -- enter the same value when configuring the webhook in Meta's dashboard.
WHATSAPP_VERIFY_TOKEN=
# App Secret (Meta App Dashboard > Settings > Basic) -- verifies inbound webhook calls are really from Meta.
WHATSAPP_APP_SECRET=
# The organizations.id (uuid) that owns this WhatsApp number -- inbound messages get attributed here.
WHATSAPP_ORG_ID=
